[Unit]
Description=Avvisa via mail se link@%i.service fallisce

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash -c '. /root/.config/agentmail/env; /usr/bin/agentmail inboxes:messages send --inbox-id claude.sartori@agentmail.to --to riccsartori@gmail.com --subject "%i FALLITO $(date +%%F)" --text "$(systemctl status link@%i.service --no-pager -n 30 2>&1)"'
