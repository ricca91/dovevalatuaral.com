{
  "outputDirectory": "dist",
  "functions": {
    "api/risultato-immagine.js": {
      "includeFiles": "server/fonts/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/risultato/:v/:s/:t",
      "destination": "/api/risultato?v=:v&s=:s&t=:t"
    },
    {
      "source": "/risultato-immagine/:v/:s/:t.png",
      "destination": "/api/risultato-immagine?v=:v&s=:s&t=:t"
    },
    {
      "source": "/sponsor-loghi/:file",
      "destination": "https://rifkyfawojizgbzabyxn.supabase.co/storage/v1/object/public/sponsor-loghi/:file"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)|risultato(?:/|$)|\\.well-known(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/sponsor/approva/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/sponsor/grazie/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
