{
  "outputDirectory": "dist",
  "functions": {
    "api/risultato-immagine.js": {
      "includeFiles": "server/fonts/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/risultato/:v/:s/:t",
      "destination": "/api/risultato?v=:v&s=:s&t=:t"
    },
    {
      "source": "/risultato-immagine/:v/:s/:t.png",
      "destination": "/api/risultato-immagine?v=:v&s=:s&t=:t"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)|risultato(?:/|$)|\\.well-known(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build"
}
